@model List<BaiTapLon.Models.Review>
@{ ViewData["Title"] = "Đánh giá"; }
<h1 class="h3 fw-bold mb-1">Đánh giá khách hàng</h1><p class="text-muted mb-4">Duyệt nội dung trước khi hiển thị công khai.</p>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Khách hàng</th><th>Món</th><th>Đánh giá</th><th>Nội dung</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.CustomerName<br/><small>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td>@r.Product?.Name</td><td class="text-warning">@string.Concat(Enumerable.Repeat("★", r.Rating))</td><td>@r.Comment</td><td><span class="badge @(r.IsApproved ? "bg-success" : "bg-warning text-dark")">@(r.IsApproved ? "Đã duyệt" : "Chờ duyệt")</span></td><td><div class="d-flex gap-1"><form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.ReviewId"/><input type="hidden" name="approved" value="@(!r.IsApproved ? "true" : "false")"/><button class="btn btn-sm btn-outline-primary">@(r.IsApproved ? "Ẩn" : "Duyệt")</button></form>@if(User.IsInRole("Admin")){<form asp-action="Delete" asp-route-id="@r.ReviewId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa</button></form>}</div></td></tr>}</tbody></table></div></div>
