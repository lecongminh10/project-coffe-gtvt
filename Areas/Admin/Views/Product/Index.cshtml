@model IEnumerable<BaiTapLon.Models.Product>
@{
    ViewData["Title"] = "Quản Lý Món & Đồ Uống";
    var currentCat = ViewBag.CurrentCategory as int?;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 text-dark fw-bold"><i class="fas fa-mug-hot text-danger me-2"></i>Quản Trị Thực Đơn Món</h1>
        <p class="text-muted small mb-0">Quản lý giá cả, hình ảnh, phân loại và kích hoạt phục vụ món ăn đồ uống.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
        <i class="fas fa-plus me-1"></i> Thêm Món Mới
    </a>
</div>

<!-- Bộ lọc và tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-search"></i></span>
                <input type="text" name="search" class="form-control border-start-0 rounded-end-pill" placeholder="Tìm theo tên món..." value="@currentSearch" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select rounded-pill" asp-items="ViewBag.Categories">
                <option value="">-- Tất cả danh mục --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill w-100"><i class="fas fa-filter me-1"></i> Lọc Dữ Liệu</button>
            @if (currentCat != null || !string.IsNullOrEmpty(currentSearch))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="Xóa bộ lọc"><i class="fas fa-redo"></i></a>
            }
        </div>
    </form>
</div>

<!-- Danh sách món -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th class="ps-3" style="width: 70px;">ID</th>
                        <th style="width: 80px;">Hình Ảnh</th>
                        <th>Tên Món</th>
                        <th>Danh Mục</th>
                        <th>Đơn Giá</th>
                        <th>Nổi Bật</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Không tìm thấy món ăn nào theo tiêu chí tìm kiếm.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@item.ProductId</td>
                                <td>
                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(item.Category?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td class="fw-bold text-success">@item.Price.ToString("N0") đ</td>
                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-dark fw-bold"><i class="fas fa-star text-warning me-1"></i>Hot</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success">Phục vụ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-15 text-muted">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Chỉnh sửa">
                                            <i class="fas fa-edit" style="font-size: 0.8rem;"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa món @item.Name?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Xóa món">
                                                <i class="fas fa-trash-alt" style="font-size: 0.8rem;"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
