@model IEnumerable<BaiTapLon.Models.Product>
@{
    ViewData["Title"] = "Quản Lý Món & Đồ Uống";
    var currentCat = ViewBag.CurrentCategory as int?;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-mug-hot text-danger me-2"></i>Quản Lý Thực Đơn Quán</h1>
        <p class="text-muted small mb-0">Quản lý giá cả, hình ảnh và trạng thái phục vụ của toàn bộ đồ uống.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus me-1"></i> Thêm Món Mới
    </a>
</div>

<!-- Bộ lọc và tìm kiếm -->
<div class="card border-0 shadow-sm rounded-3 bg-white p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm theo tên món..." value="@currentSearch" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">-- Tất cả danh mục --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Lọc</button>
            @if (currentCat != null || !string.IsNullOrEmpty(currentSearch))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="fas fa-redo"></i></a>
            }
        </div>
    </form>
</div>

<!-- Danh sách món -->
<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 80px;">Hình Ảnh</th>
                        <th>Tên Món</th>
                        <th>Danh Mục</th>
                        <th>Đơn Giá</th>
                        <th>Nổi Bật</th>
                        <th>Trạng Thái</th>
                        <th class="text-end" style="width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@item.ProductId</td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                            </td>
                            <td>
                                <div class="fw-bold">@item.Name</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(item.Category?.Name ?? "N/A")</span>
                            </td>
                            <td class="fw-bold text-success">@item.Price.ToString("N0") đ</td>
                            <td>
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-star me-1"></i>Hot</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Đang phục vụ</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm hết</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa món này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
