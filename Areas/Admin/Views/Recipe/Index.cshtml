@model BaiTapLon.Models.ViewModels.RecipeManagementViewModel
@{ ViewData["Title"] = "Công thức pha chế"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Công thức pha chế</h1><p class="text-muted">Định lượng được dùng để tự động trừ kho khi xử lý đơn.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recipeModal">Thêm định lượng</button></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Món</th><th>Nguyên liệu</th><th>Định lượng/1 món</th><th></th></tr></thead><tbody>
@foreach(var r in Model.Recipes){<tr><td>@r.Product?.Name</td><td>@r.Ingredient?.Name</td><td><strong>@r.AmountNeeded.ToString("N2") @r.Unit</strong></td><td><form asp-action="Delete" asp-route-id="@r.RecipeId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa định lượng này?')">Xóa</button></form></td></tr>}
</tbody></table></div></div>
<div class="modal fade" id="recipeModal"><div class="modal-dialog"><form asp-action="Save" method="post" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Thêm định lượng</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Món</label><select name="ProductId" class="form-select mb-3">@foreach(var p in Model.Products){<option value="@p.ProductId">@p.Name</option>}</select><label class="form-label">Nguyên liệu</label><select name="IngredientId" class="form-select mb-3">@foreach(var i in Model.Ingredients){<option value="@i.IngredientId">@i.Name (@i.BaseUnit)</option>}</select><label class="form-label">Định lượng theo đơn vị cơ sở</label><input name="AmountNeeded" type="number" step="0.01" min="0.01" class="form-control" required/></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div>
