@model BaiTapLon.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng Thống Kê Quán Café";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-tachometer-alt text-warning me-2"></i>Bảng Điều Khiển Quán Café</h1>
        <p class="text-muted small mb-0">Theo dõi doanh thu, tình trạng bàn và các đơn đặt món theo thời gian thực.</p>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-receipt me-1"></i> Xem Tất Cả Đơn Hàng
        </a>
    </div>
</div>

<!-- 4 Thẻ Thống Kê Chính -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4 h-100 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Doanh Thu Đã Thu</div>
                    <div class="h4 mb-0 fw-bold text-success">@Model.TotalRevenue.ToString("N0") <small class="fs-6">đ</small></div>
                </div>
                <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success">
                    <i class="fas fa-dollar-sign fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4 h-100 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tổng Đơn Đặt Món</div>
                    <div class="h4 mb-0 fw-bold text-primary">@Model.TotalOrders</div>
                </div>
                <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-shopping-cart fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Tình Trạng Bàn</div>
                    <div class="h5 mb-0 fw-bold">
                        <span class="text-danger">@Model.OccupiedTables Có khách</span> / 
                        <span class="text-success">@Model.AvailableTables Trống</span>
                    </div>
                </div>
                <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-chair fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4 h-100 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Món Đang Phục Vụ</div>
                    <div class="h4 mb-0 fw-bold text-info">@Model.TotalProducts</div>
                </div>
                <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info">
                    <i class="fas fa-coffee fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Bảng đơn hàng gần đây -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-clock text-muted me-2"></i>Đơn Đặt Món Gần Đây</h6>
                <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem thêm</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Mã Đơn</th>
                                <th>Khách Hàng</th>
                                <th>Bàn</th>
                                <th>Thời Gian</th>
                                <th>Tổng Tiền</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào trong hệ thống.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold">#@o.OrderId</td>
                                        <td>
                                            <div class="fw-bold">@o.CustomerName</div>
                                            <small class="text-muted">@o.CustomerPhone</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@(o.Table?.TableName ?? "Mang về")</span>
                                        </td>
                                        <td class="small text-muted">@o.OrderDate.ToString("HH:mm dd/MM")</td>
                                        <td class="fw-bold text-success">@o.TotalAmount.ToString("N0") đ</td>
                                        <td>
                                            @if (o.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                            }
                                            else if (o.Status == "Processing")
                                            {
                                                <span class="badge bg-info text-dark">Đang làm</span>
                                            }
                                            else if (o.Status == "Completed")
                                            {
                                                <span class="badge bg-success">Hoàn tất</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hủy</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Món bán chạy nhất -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-dark"><i class="fas fa-star text-warning me-2"></i>Món Bán Chạy (Top Menu)</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.TopProducts)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 px-0">
                            <img src="@p.ImageUrl" alt="@p.Name" class="rounded-3" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-0" style="font-size: 0.95rem;">@p.Name</h6>
                                <small class="text-muted">@(p.Category?.Name ?? "Đồ uống")</small>
                            </div>
                            <span class="fw-bold text-primary">@p.Price.ToString("N0") đ</span>
                        </li>
                    }
                </ul>
                <div class="mt-3 text-center">
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">
                        Quản lý toàn bộ thực đơn
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
