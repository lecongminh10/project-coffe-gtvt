@model List<BaiTapLon.Models.User>
@{ ViewData["Title"] = "Tài khoản"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Tài khoản người dùng</h1><p class="text-muted">Quản lý khách hàng, nhân viên và quản trị viên.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal">Thêm tài khoản</button></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Liên hệ</th><th>Vai trò</th><th>Ngày tạo</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td><strong>@u.Username</strong></td><td>@u.FullName</td><td>@u.Email<br/><small>@u.PhoneNumber</small></td><td><span class="badge @(u.Role == "Admin" ? "bg-danger" : u.Role == "Staff" ? "bg-primary" : "bg-secondary")">@u.Role</span></td><td>@u.CreatedAt.ToString("dd/MM/yyyy")</td><td><form asp-action="Delete" asp-route-id="@u.UserId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa tài khoản này?')">Xóa</button></form></td></tr>}</tbody></table></div></div>
<div class="modal fade" id="userModal"><div class="modal-dialog"><form asp-action="Save" method="post" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Thêm tài khoản</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body row g-3"><div class="col-6"><label>Tên đăng nhập</label><input name="Username" class="form-control" required/></div><div class="col-6"><label>Họ tên</label><input name="FullName" class="form-control" required/></div><div class="col-6"><label>Email</label><input name="Email" type="email" class="form-control"/></div><div class="col-6"><label>Số điện thoại</label><input name="PhoneNumber" class="form-control"/></div><div class="col-6"><label>Vai trò</label><select name="Role" class="form-select"><option>Staff</option><option>Customer</option><option>Admin</option></select></div><div class="col-6"><label>Mật khẩu</label><input name="Password" type="password" minlength="6" class="form-control" required/></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div>
