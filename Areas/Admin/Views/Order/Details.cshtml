@model BaiTapLon.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.OrderId;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 no-print">
    <div>
        <h1 class="h3 mb-0 text-dark fw-bold"><i class="fas fa-file-invoice text-primary me-2"></i>Đơn Đặt Món #@Model.OrderId</h1>
        <p class="text-muted small mb-0">Thời gian tạo: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Quay Lại
        </a>
        <button onclick="window.print()" class="btn btn-dark btn-sm rounded-pill px-3 text-white shadow-sm">
            <i class="fas fa-print me-1 text-warning"></i> In Phiếu Pha Chế / Hóa Đơn (80mm)
        </button>
    </div>
</div>

<div class="row g-4 no-print">
    <!-- Cột thông tin món ăn & tổng tiền -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="fas fa-mug-hot text-warning me-2"></i>Danh Sách Món Được Gọi
            </h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Món</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(item.Product?.ImageUrl ?? "/images/products/ca-phe-den.jpg")" class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                                        <div>
                                            <div class="fw-bold text-dark">@(item.Product?.Name ?? $"Món #{item.ProductId}")</div>
                                            <small class="text-muted">Mã món: #@item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-dark rounded-circle px-2 py-1 fs-6">@item.Quantity</span>
                                </td>
                                <td class="text-end text-muted">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-end fw-bold text-dark">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-bold fs-6">Tổng Tiền Đơn Hàng:</td>
                            <td class="text-end fw-bold fs-5 text-success">@Model.TotalAmount.ToString("N0") VNĐ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="alert alert-warning border-0 bg-warning bg-opacity-10 mt-4 mb-0 rounded-3">
                    <i class="fas fa-comment-dots text-warning me-2"></i><strong>Yêu cầu đặc biệt của khách:</strong> @Model.Notes
                </div>
            }
            @if (Model.DiscountAmount > 0)
            {
                <div class="alert alert-success mt-3 mb-0">Voucher <strong>@Model.VoucherCode</strong>: giảm @Model.DiscountAmount.ToString("N0")đ</div>
            }
        </div>
    </div>

    <!-- Cột cập nhật trạng thái đơn và thanh toán -->
    <div class="col-lg-4">
        <!-- Thông tin khách hàng & Vị trí -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="fas fa-user-circle text-primary me-2"></i>Thông Tin Phục Vụ
            </h5>
            <div class="small d-flex flex-column gap-2">
                <div><span class="text-muted">Khách hàng:</span> <strong class="text-dark">@Model.CustomerName</strong></div>
                <div><span class="text-muted">Điện thoại:</span> <span class="text-dark">@Model.CustomerPhone</span></div>
                <div>
                    <span class="text-muted">Vị trí:</span> 
                    @if (Model.Table != null)
                    {
                        <span class="badge bg-warning bg-opacity-20 text-dark fw-bold">
                            <i class="fas fa-chair me-1"></i> @Model.Table.TableName (@Model.Table.Area)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted">Mang về (Take-Away)</span>
                    }
                </div>
                <div><span class="text-muted">Thanh toán:</span> <span class="badge bg-light text-dark fw-bold">@Model.PaymentMethod</span></div>
                <div><span class="text-muted">Kho:</span> <span class="badge @(Model.InventoryDeducted ? "bg-success" : "bg-secondary")">@(Model.InventoryDeducted ? "Đã trừ" : "Chưa trừ")</span></div>
                <div>
                    <span class="text-muted">Tình trạng tiền:</span>
                    @if (Model.IsPaid)
                    {
                        <span class="badge bg-success bg-opacity-15 text-success"><i class="fas fa-check-circle me-1"></i>Đã thu tiền</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-15 text-danger"><i class="fas fa-exclamation-circle me-1"></i>Chưa thu tiền</span>
                    }
                </div>
            </div>
        </div>

        <!-- Form chuyển trạng thái đơn hàng -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="fas fa-sliders-h text-warning me-2"></i>Cập Nhật Tiến Độ Quầy
            </h5>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.OrderId" />

                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">Trạng Thái Đơn Hàng:</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Chờ tiếp nhận (Pending)</option>
                        <option value="Processing" selected="@(Model.Status == "Processing")">Đang pha chế (Processing)</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Hoàn thành (Completed)</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Hủy đơn (Cancelled)</option>
                    </select>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input name="isPaid" type="checkbox" value="true" class="form-check-input" id="isPaidSwitch" checked="@(Model.IsPaid)" />
                        <label class="form-check-label fw-bold small" for="isPaidSwitch">Đã Thu Tiền Khách</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm">
                    <i class="fas fa-save me-1"></i> Cập Nhật Tiến Độ
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ==========================================================================
     KHU VỰC IN HÓA ĐƠN NHIỆT POS 80MM (CHỈ HIỂN THỊ KHI IN)
     ========================================================================== -->
<div id="printableReceipt" class="d-none d-print-block">
    <div style="text-align: center; border-bottom: 1px dashed #000; padding-bottom: 8px; margin-bottom: 8px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: bold;">BREW & GO COFFEE</h3>
        <div style="font-size: 11px;">Đại học GTVT - Hotline: 0901 234 567</div>
        <div style="font-size: 12px; font-weight: bold; margin-top: 4px;">PHIẾU THANH TOÁN / PHA CHẾ</div>
        <div style="font-size: 11px;">Số: #@Model.OrderId - @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div style="font-size: 12px; font-weight: bold; margin-top: 2px;">
            @(Model.Table != null ? $"BÀN: {Model.Table.TableName} ({Model.Table.Area})" : "MANG VỀ")
        </div>
        <div style="font-size: 11px;">Khách: @Model.CustomerName - @Model.CustomerPhone</div>
    </div>

    <table style="width: 100%; font-size: 11px; border-collapse: collapse; margin-bottom: 8px;">
        <thead>
            <tr style="border-bottom: 1px solid #000;">
                <th style="text-align: left;">Món</th>
                <th style="text-align: center; width: 30px;">SL</th>
                <th style="text-align: right; width: 60px;">T.Tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td style="padding: 3px 0;">@(d.Product?.Name ?? $"Món #{d.ProductId}")</td>
                    <td style="text-align: center;">@d.Quantity</td>
                    <td style="text-align: right;">@((d.UnitPrice * d.Quantity).ToString("N0"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div style="border-top: 1px dashed #000; padding-top: 6px; font-size: 12px;">
        <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 13px;">
            <span>TỔNG CỘNG:</span>
            <span>@Model.TotalAmount.ToString("N0") VNĐ</span>
        </div>
        <div style="font-size: 11px; margin-top: 4px;">
            PTTT: @Model.PaymentMethod - @(Model.IsPaid ? "ĐÃ THANH TOÁN" : "CHƯA THANH TOÁN")
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="font-size: 10px; margin-top: 4px; font-style: italic;">
                Ghi chú: @Model.Notes
            </div>
        }
    </div>

    <div style="text-align: center; margin-top: 12px; font-size: 10px; border-top: 1px dashed #000; padding-top: 6px;">
        Cảm ơn Quý khách & Hẹn gặp lại!<br />
        wifi: BrewAndGo_Free / pass: 88888888
    </div>
</div>
