@model IEnumerable<BaiTapLon.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Món";
    var currentStatus = ViewBag.CurrentStatus as string;
    int totalCount = Model.Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 text-dark fw-bold"><i class="fas fa-receipt text-primary me-2"></i>Tiếp Nhận Đơn Hàng (KDS & Quầy)</h1>
        <p class="text-muted small mb-0">Theo dõi tiến độ pha chế, gọi món tại bàn, mang về và xác nhận thanh toán.</p>
    </div>
</div>

<!-- Lọc theo trạng thái đơn dạng Pills hiện đại -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(currentStatus) ? "btn-dark fw-bold" : "btn-light text-muted")">
            Tất Cả (@totalCount)
        </a>
        <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Pending" ? "btn-warning fw-bold text-dark" : "btn-light text-muted")">
            <i class="fas fa-hourglass-half me-1"></i> Chờ Tiếp Nhận
        </a>
        <a asp-action="Index" asp-route-status="Processing" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Processing" ? "btn-primary fw-bold" : "btn-light text-muted")">
            <i class="fas fa-blender me-1"></i> Đang Pha Chế
        </a>
        <a asp-action="Index" asp-route-status="Completed" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Completed" ? "btn-success fw-bold" : "btn-light text-muted")">
            <i class="fas fa-check-circle me-1"></i> Hoàn Thành
        </a>
        <a asp-action="Index" asp-route-status="Cancelled" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Cancelled" ? "btn-danger fw-bold" : "btn-light text-muted")">
            <i class="fas fa-times-circle me-1"></i> Đã Hủy
        </a>
    </div>
</div>

<!-- Bảng danh sách đơn hàng -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th class="ps-3" style="width: 90px;">Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Số ĐT</th>
                        <th>Vị Trí Phục Vụ</th>
                        <th>Thời Gian</th>
                        <th class="text-center">Số Lượng</th>
                        <th>Tổng Tiền</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="fas fa-inbox fa-3x text-light mb-2"></i>
                                    <div>Không có đơn hàng nào theo bộ lọc đang chọn.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">#@o.OrderId</td>
                                <td>
                                    <div class="fw-bold text-dark">@o.CustomerName</div>
                                    @if (!string.IsNullOrEmpty(o.Notes))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 160px;" title="@o.Notes">
                                            <i class="fas fa-comment-dots text-warning"></i> @o.Notes
                                        </small>
                                    }
                                </td>
                                <td class="small text-muted">@o.CustomerPhone</td>
                                <td>
                                    @if (o.Table != null)
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-dark fw-bold">
                                            <i class="fas fa-chair me-1"></i> @o.Table.TableName (@o.Table.Area)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">
                                            <i class="fas fa-shopping-bag me-1"></i> Mang về
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">@o.OrderDate.ToString("HH:mm dd/MM")</td>
                                <td class="fw-bold text-center">@(o.OrderDetails?.Sum(od => od.Quantity) ?? 0)</td>
                                <td class="fw-bold text-success">@o.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    @if (o.IsPaid)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success">
                                            <i class="fas fa-check-circle me-1"></i> Đã trả (@o.PaymentMethod)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-15 text-danger">
                                            <i class="fas fa-clock me-1"></i> Chưa trả (@o.PaymentMethod)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (o.Status == "Pending")
                                    {
                                        <span class="order-status-badge status-badge-pending">
                                            <i class="fas fa-hourglass-half"></i> Chờ duyệt
                                        </span>
                                    }
                                    else if (o.Status == "Processing")
                                    {
                                        <span class="order-status-badge status-badge-processing">
                                            <i class="fas fa-blender"></i> Pha chế
                                        </span>
                                    }
                                    else if (o.Status == "Completed")
                                    {
                                        <span class="order-status-badge status-badge-completed">
                                            <i class="fas fa-check"></i> Hoàn thành
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="order-status-badge status-badge-cancelled">
                                            <i class="fas fa-times"></i> Đã hủy
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Xem chi tiết & Cập nhật">
                                        <i class="fas fa-eye me-1"></i> Xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
