@model List<BaiTapLon.Models.News>
@{ ViewData["Title"] = "Tin tức"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Tin tức & sự kiện</h1><p class="text-muted">Quản lý nội dung hiển thị trên website.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newsModal">Viết bài</button></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tiêu đề</th><th>Tác giả</th><th>Ngày đăng</th><th>Lượt xem</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var n in Model){<tr><td><strong>@n.Title</strong><br/><small>/News/@n.Slug</small></td><td>@n.Author?.FullName</td><td>@n.PublishedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@n.ViewCount</td><td><span class="badge @(n.IsActive ? "bg-success" : "bg-secondary")">@(n.IsActive ? "Công khai" : "Ẩn")</span></td><td><form asp-action="Delete" asp-route-id="@n.NewsId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa bài viết?')">Xóa</button></form></td></tr>}</tbody></table></div></div>
<div class="modal fade" id="newsModal"><div class="modal-dialog modal-lg"><form asp-action="Save" method="post" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Bài viết mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>Tiêu đề</label><input name="Title" class="form-control mb-3" required/><label>Tóm tắt</label><textarea name="Summary" class="form-control mb-3" rows="2"></textarea><label>Nội dung (hỗ trợ HTML)</label><textarea name="Content" class="form-control mb-3" rows="8" required></textarea><label>URL hình ảnh</label><input name="ImageUrl" class="form-control mb-3"/><div class="row"><div class="col-6"><label>Ngày đăng</label><input name="PublishedAt" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control"/></div><div class="col-6 form-check mt-4"><input name="IsActive" value="true" checked type="checkbox" class="form-check-input"/><label class="form-check-label">Công khai</label></div></div></div><div class="modal-footer"><button class="btn btn-primary">Đăng bài</button></div></form></div></div>
