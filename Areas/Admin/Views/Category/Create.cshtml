@model BaiTapLon.Models.Category
@{
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-plus-circle text-primary me-2"></i>Thêm Danh Mục Mới</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Quay Lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Sinh Tố & Nước Ép" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold small text-muted"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả ngắn về danh mục..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Icon" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="Icon" class="form-control" placeholder="fa-coffee, fa-leaf, fa-glass-water" />
                        <span asp-validation-for="Icon" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" value="1" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Lưu Danh Mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
