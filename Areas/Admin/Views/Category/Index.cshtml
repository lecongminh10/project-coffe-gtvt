@model IEnumerable<BaiTapLon.Models.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 text-dark fw-bold"><i class="fas fa-tags text-info me-2"></i>Quản Trị Danh Mục Đồ Uống</h1>
        <p class="text-muted small mb-0">Thêm, sửa, xóa các nhóm đồ uống trong thực đơn hệ thống Brew & Go.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
        <i class="fas fa-plus me-1"></i> Thêm Danh Mục Mới
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th class="ps-3" style="width: 70px;">ID</th>
                        <th>Biểu Tượng</th>
                        <th>Tên Danh Mục</th>
                        <th>Mô Tả</th>
                        <th class="text-center">Số Món</th>
                        <th class="text-center">Thứ Tự</th>
                        <th class="text-end pe-3" style="width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">#@item.CategoryId</td>
                            <td>
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning" style="width: 40px; height: 40px;">
                                    <i class="fas @(string.IsNullOrEmpty(item.Icon) ? "fa-mug-hot" : item.Icon)"></i>
                                </div>
                            </td>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td class="text-muted small">@item.Description</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border rounded-pill px-3">@(item.Products?.Count ?? 0) món</span>
                            </td>
                            <td class="text-center fw-bold">@item.DisplayOrder</td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Chỉnh sửa">
                                        <i class="fas fa-edit" style="font-size: 0.8rem;"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Xóa danh mục">
                                            <i class="fas fa-trash-alt" style="font-size: 0.8rem;"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
