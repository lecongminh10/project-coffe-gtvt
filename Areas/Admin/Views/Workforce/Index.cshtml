@model BaiTapLon.Models.ViewModels.WorkforceViewModel
@{ ViewData["Title"] = "Nhân sự và chấm công"; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-4"><div><h1 class="h3 fw-bold">Phân ca & chấm công</h1><p class="text-muted">Theo dõi giờ làm và tiền công tạm tính.</p></div>@if(User.IsInRole("Admin")){<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#scheduleModal">Phân ca</button>}</div>
<form class="row g-2 mb-3"><div class="col-auto"><input type="date" name="from" value="@ViewBag.From" class="form-control"/></div><div class="col-auto"><input type="date" name="to" value="@ViewBag.To" class="form-control"/></div><div class="col-auto"><button class="btn btn-outline-primary">Lọc</button></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Ngày</th><th>Nhân viên</th><th>Ca</th><th>Check-in/out</th><th>Giờ công</th><th>Tiền công</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var s in Model.Schedules){<tr><td>@s.WorkDate.ToString("dd/MM/yyyy")</td><td>@s.User?.FullName</td><td>@s.Shift?.ShiftName<br/><small>@s.Shift?.StartTime.ToString(@"hh\:mm") - @s.Shift?.EndTime.ToString(@"hh\:mm")</small></td><td>@(s.CheckInTime?.ToString("HH:mm") ?? "--") / @(s.CheckOutTime?.ToString("HH:mm") ?? "--")</td><td>@s.WorkedHours.ToString("N2")</td><td>@s.EstimatedWage.ToString("N0")đ</td><td><span class="badge bg-secondary">@s.Status</span></td><td class="d-flex gap-1">@if(!s.CheckInTime.HasValue){<form asp-action="CheckIn" asp-route-id="@s.ScheduleId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Vào ca</button></form>}else if(!s.CheckOutTime.HasValue){<form asp-action="CheckOut" asp-route-id="@s.ScheduleId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-warning">Tan ca</button></form>}</td></tr>}
</tbody><tfoot><tr><th colspan="5" class="text-end">Tổng tiền công:</th><th>@Model.TotalEstimatedWage.ToString("N0")đ</th><th colspan="2"></th></tr></tfoot></table></div></div>
@if(User.IsInRole("Admin")){<div class="modal fade" id="scheduleModal"><div class="modal-dialog"><form asp-action="CreateSchedule" method="post" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Phân ca</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>Nhân viên</label><select name="UserId" class="form-select mb-3">@foreach(var u in Model.Staff){<option value="@u.UserId">@u.FullName (@u.Role)</option>}</select><label>Ca</label><select name="ShiftId" class="form-select mb-3">@foreach(var s in Model.Shifts){<option value="@s.ShiftId">@s.ShiftName</option>}</select><label>Ngày làm</label><input name="WorkDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control mb-3"/><label>Ghi chú</label><input name="Note" class="form-control"/></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div>}
