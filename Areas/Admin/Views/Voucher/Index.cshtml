@model List<BaiTapLon.Models.Voucher>
@{ ViewData["Title"] = "Voucher"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Mã khuyến mãi</h1><p class="text-muted">Quản lý điều kiện, thời hạn và lượt sử dụng.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#voucherModal">Thêm voucher</button></div>
<div class="row g-3">@foreach(var v in Model){<div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h4 class="text-primary fw-bold">@v.Code</h4><span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">@(v.IsActive ? "Đang bật" : "Đã tắt")</span></div><p class="fs-5">Giảm @v.DiscountPercent% · tối đa @v.MaxDiscountAmount.ToString("N0")đ</p><div class="small text-muted">Đơn tối thiểu @v.MinOrderAmount.ToString("N0")đ<br/>@v.StartDate.ToString("dd/MM/yyyy") – @v.EndDate.ToString("dd/MM/yyyy")<br/>Đã dùng @v.UsedCount/@v.UsageLimit</div><form asp-action="Delete" asp-route-id="@v.VoucherId" method="post" class="mt-3">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa voucher?')">Xóa</button></form></div></div></div>}</div>
<div class="modal fade" id="voucherModal"><div class="modal-dialog"><form asp-action="Save" method="post" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Thêm voucher</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body row g-3"><div class="col-12"><label>Mã</label><input name="Code" class="form-control" required/></div><div class="col-6"><label>% giảm</label><input name="DiscountPercent" type="number" min="1" max="100" value="10" class="form-control"/></div><div class="col-6"><label>Giảm tối đa</label><input name="MaxDiscountAmount" type="number" value="50000" class="form-control"/></div><div class="col-6"><label>Đơn tối thiểu</label><input name="MinOrderAmount" type="number" value="0" class="form-control"/></div><div class="col-6"><label>Giới hạn lượt</label><input name="UsageLimit" type="number" value="100" class="form-control"/></div><div class="col-6"><label>Bắt đầu</label><input name="StartDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-6"><label>Kết thúc</label><input name="EndDate" type="date" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-12 form-check ms-2"><input name="IsActive" value="true" type="checkbox" checked class="form-check-input"/><label class="form-check-label">Kích hoạt</label></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div>
