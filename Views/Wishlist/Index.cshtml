@model List<BaiTapLon.Models.Wishlist>
@{ ViewData["Title"] = "Món yêu thích"; }
<div class="container py-5"><h1 class="fw-bold mb-4">Món yêu thích</h1>@if(!Model.Any()){<div class="alert alert-light border">Bạn chưa lưu món yêu thích nào.</div>}else{<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">@foreach(var w in Model){<div class="col"><div class="card h-100 border-0 shadow-sm"><img src="@w.Product?.ImageUrl" class="card-img-top" style="height:180px;object-fit:cover"/><div class="card-body"><h5>@w.Product?.Name</h5><p class="text-success fw-bold">@w.Product?.Price.ToString("N0")đ</p><div class="d-grid gap-2"><a asp-controller="Product" asp-action="Details" asp-route-id="@w.ProductId" class="btn btn-primary">Xem món</a><form asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@w.ProductId"/><button class="btn btn-outline-danger w-100">Bỏ yêu thích</button></form></div></div></div></div>}</div>}</div>
