@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white d-inline-block" style="max-width: 500px;">
        <div class="text-danger mb-3">
            <i class="fas fa-exclamation-triangle fa-4x"></i>
        </div>
        <h3 class="fw-bold text-dark">Truy Cập Bị Từ Chối</h3>
        <p class="text-muted">Bạn không có quyền hạn (Role) để truy cập vào phân hệ này. Vui lòng liên hệ Quản trị viên hoặc đăng nhập bằng tài khoản có quyền thích hợp.</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về Trang Chủ</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-coffee">Đăng Nhập Lại</a>
        </div>
    </div>
</div>
