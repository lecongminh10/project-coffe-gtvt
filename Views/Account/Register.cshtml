@model BaiTapLon.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Mới";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="auth-modern-card">
                <div class="text-center mb-4">
                    <div class="brand-icon-box mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.5rem;">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Tạo Tài Khoản Mới</h3>
                    <p class="text-muted small">Đăng ký thành viên để nhận ngay ưu đãi và tích điểm đồ uống</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3 rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-id-card"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0 rounded-end-pill" placeholder="Họ và tên của bạn" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-user"></i></span>
                            <input asp-for="Username" class="form-control border-start-0 rounded-end-pill" placeholder="Tên đăng nhập (viết liền không dấu)" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-phone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control border-start-0 rounded-end-pill" placeholder="0912345678" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 rounded-end-pill" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" class="form-control border-start-0 rounded-end-pill" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill ps-3"><i class="fas fa-shield-alt"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0 rounded-end-pill" placeholder="Nhập lại mật khẩu" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-coffee-amber w-100 py-3 mb-3 fs-6">
                        <i class="fas fa-user-plus me-1"></i> Đăng Ký Tài Khoản
                    </button>

                    <div class="text-center small text-muted">
                        Đã có tài khoản? <a asp-action="Login" class="fw-bold text-dark">Đăng nhập ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
