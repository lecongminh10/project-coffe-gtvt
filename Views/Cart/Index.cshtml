@model BaiTapLon.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ Hàng & Đặt Món";
    var tables = ViewBag.AvailableTables as List<BaiTapLon.Models.CoffeeTable> ?? new List<BaiTapLon.Models.CoffeeTable>();
}

<div class="container my-4 my-md-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="brand-icon-box" style="width: 44px; height: 44px;">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark mb-0">Giỏ Hàng Của Bạn</h2>
            <p class="text-muted small mb-0">Kiểm tra các món đã chọn và tiến hành đặt hàng nhanh chóng</p>
        </div>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="py-5">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 bg-light" style="width: 80px; height: 80px;">
                    <i class="fas fa-mug-hot fa-3x text-muted"></i>
                </div>
                <h4 class="text-dark fw-bold mb-2">Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted mb-4">Hãy dạo quanh thực đơn và chọn những ly cà phê hoặc thức uống tươi ngon nhé!</p>
                <a asp-controller="Product" asp-action="Index" class="btn-coffee-amber">
                    <i class="fas fa-book-open"></i> Xem Thực Đơn Ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột danh sách món trong giỏ -->
            <div class="col-lg-7">
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item-card">
                            <div class="row align-items-center g-3">
                                <div class="col-auto">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3 shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                                </div>
                                <div class="col">
                                    <h6 class="fw-bold text-dark mb-1">@item.ProductName</h6>
                                    <div class="text-muted small">Đơn giá: <strong class="text-dark">@item.Price.ToString("N0") đ</strong></div>
                                </div>
                                <div class="col-auto">
                                    <!-- Stepper Quantity -->
                                    <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <div class="qty-stepper">
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="qty-btn" title="Giảm">-</button>
                                            <span class="qty-display">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn" title="Tăng">+</button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-auto text-end" style="min-width: 100px;">
                                    <div class="fw-bold fs-6" style="color: var(--coffee-primary);">@item.TotalPrice.ToString("N0") đ</div>
                                </div>
                                <div class="col-auto">
                                    <form asp-action="RemoveItem" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm text-danger rounded-circle p-2" title="Xóa món" onclick="return confirm('Bạn có chắc muốn xóa món @item.ProductName khỏi giỏ?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2">
                    <a asp-controller="Product" asp-action="Index" class="btn-coffee-outline">
                        <i class="fas fa-arrow-left"></i> Tiếp tục chọn món
                    </a>
                    <span class="text-muted small">
                        <i class="fas fa-shield-alt text-success me-1"></i> Giỏ hàng bảo mật với Session ASP.NET Core
                    </span>
                </div>
            </div>

            <!-- Cột thông tin đặt món (Checkout form) -->
            <div class="col-lg-5">
                <div class="order-summary-box">
                    <h5 class="fw-bold mb-3 text-dark border-bottom pb-3">
                        <i class="fas fa-clipboard-check text-warning me-2"></i> Xác Nhận Đặt Món
                    </h5>

                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                        <!-- Loại hình phục vụ Tabs -->
                        <label class="form-label fw-bold small text-muted mb-2">Hình Thức Phục Vụ:</label>
                        <div class="order-type-tabs">
                            <button type="button" class="order-type-tab-btn active" id="tabDineIn" onclick="setOrderType('DineIn')">
                                <i class="fas fa-chair"></i> Dùng Tại Quán
                            </button>
                            <button type="button" class="order-type-tab-btn" id="tabTakeAway" onclick="setOrderType('TakeAway')">
                                <i class="fas fa-shopping-bag"></i> Mang Về
                            </button>
                        </div>
                        <input type="hidden" asp-for="OrderType" id="orderTypeHidden" value="DineIn" />

                        <!-- Chọn bàn (ẩn khi mang về) -->
                        <div class="mb-3" id="tableSelectionDiv">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label asp-for="TableId" class="form-label fw-bold small text-muted mb-0">Chọn Bàn Ngồi:</label>
                                <span class="badge bg-light text-muted small">Nhấn chọn bàn trực tiếp</span>
                            </div>

                            <!-- Lưới thẻ bàn trực quan sinh động -->
                            <div class="checkout-table-grid mb-2">
                                @foreach (var t in tables)
                                {
                                    bool isAvail = t.Status == "Available";
                                    <div class="checkout-table-item @(isAvail ? "" : "opacity-50")" 
                                         data-table-id="@t.TableId" 
                                         onclick="@(isAvail ? $"selectCheckoutTable({t.TableId})" : "alert('Bàn này hiện đang có khách hoặc đã đặt!')")">
                                        <div class="table-name"><i class="fas fa-chair me-1" style="color: var(--brand-primary);"></i>@t.TableName</div>
                                        <div class="table-sub">@t.Area · @t.Capacity chỗ</div>
                                        <div class="badge rounded-pill @(isAvail ? "bg-success text-white" : "bg-danger text-white") mt-1" style="font-size: 0.65rem;">
                                            @(isAvail ? "🟢 Bàn trống" : "🔴 " + t.Status)
                                        </div>
                                    </div>
                                }
                            </div>

                            <select asp-for="TableId" id="tableSelectHidden" class="form-select rounded-3 mt-1">
                                <option value="">-- Hoặc chọn từ danh sách --</option>
                                @foreach (var t in tables)
                                {
                                    <option value="@t.TableId">@t.TableName (@t.Area - @t.Capacity chỗ - @(t.Status == "Available" ? "Đang trống" : t.Status))</option>
                                }
                            </select>
                            <span asp-validation-for="TableId" class="text-danger small"></span>
                        </div>

                        <!-- Thông tin khách hàng -->
                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-bold small text-muted"></label>
                            <input asp-for="CustomerName" class="form-control rounded-3" placeholder="Nhập họ và tên..." />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomerPhone" class="form-label fw-bold small text-muted"></label>
                            <input asp-for="CustomerPhone" class="form-control rounded-3" placeholder="Số điện thoại nhận thông báo..." />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VoucherCode" class="form-label fw-bold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-ticket-alt text-warning"></i></span>
                                <input asp-for="VoucherCode" class="form-control text-uppercase" placeholder="Ví dụ: CHAOBAN" />
                            </div>
                            <span asp-validation-for="VoucherCode" class="text-danger small"></span>
                            <small class="text-muted">Mức giảm chính xác được xác nhận khi đặt món.</small>
                        </div>

                        <!-- Phương thức thanh toán Cards -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted mb-2">Phương Thức Thanh Toán:</label>
                            <div class="d-flex flex-column gap-2">
                                <label class="payment-card-option">
                                    <input type="radio" name="PaymentMethod" value="Tiền mặt" checked class="form-check-input mt-0" />
                                    <i class="fas fa-money-bill-wave text-success fs-5"></i>
                                    <span class="payment-label small">Tiền mặt tại quầy</span>
                                </label>
                                <label class="payment-card-option">
                                    <input type="radio" name="PaymentMethod" value="Chuyển khoản QR" class="form-check-input mt-0" />
                                    <i class="fas fa-qrcode text-primary fs-5"></i>
                                    <span class="payment-label small">Chuyển khoản ngân hàng (QR Code)</span>
                                </label>
                                <label class="payment-card-option">
                                    <input type="radio" name="PaymentMethod" value="Ví MoMo" class="form-check-input mt-0" />
                                    <i class="fas fa-wallet text-danger fs-5"></i>
                                    <span class="payment-label small">Ví điện tử MoMo</span>
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold small text-muted"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="2" placeholder="Ghi chú thêm: ít đá, ít đường, phục vụ nhanh..."></textarea>
                        </div>

                        <!-- Bảng tính tiền -->
                        <div class="p-3 bg-light rounded-3 mb-4">
                            <div class="d-flex justify-content-between mb-2 small text-muted">
                                <span>Tổng số lượng:</span>
                                <span class="fw-bold text-dark">@Model.TotalQuantity món</span>
                            </div>
                            <div class="d-flex justify-content-between border-top pt-2">
                                <span class="fw-bold fs-6">Tổng thanh toán:</span>
                                <span class="fw-bold fs-5" style="color: var(--coffee-primary);">@Model.GrandTotal.ToString("N0") VNĐ</span>
                            </div>
                        </div>

                        <button type="submit" class="btn-coffee-amber w-100 py-3 fs-6">
                            <i class="fas fa-check-circle me-1"></i> Xác Nhận Đặt Hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setOrderType(type) {
            document.getElementById('orderTypeHidden').value = type;
            const tableDiv = document.getElementById('tableSelectionDiv');
            const tabDineIn = document.getElementById('tabDineIn');
            const tabTakeAway = document.getElementById('tabTakeAway');

            if (type === 'TakeAway') {
                tabTakeAway.classList.add('active');
                tabDineIn.classList.remove('active');
                tableDiv.style.display = 'none';
            } else {
                tabDineIn.classList.add('active');
                tabTakeAway.classList.remove('active');
                tableDiv.style.display = 'block';
            }
        }

        function selectCheckoutTable(tableId) {
            document.getElementById('tableSelectHidden').value = tableId;
            document.querySelectorAll('.checkout-table-item').forEach(el => {
                el.classList.remove('selected');
                if (el.getAttribute('data-table-id') == tableId) {
                    el.classList.add('selected');
                }
            });
        }

        // Tự động đồng bộ nếu người dùng chọn từ dropdown
        document.getElementById('tableSelectHidden')?.addEventListener('change', function() {
            selectCheckoutTable(this.value);
        });
    </script>
}
