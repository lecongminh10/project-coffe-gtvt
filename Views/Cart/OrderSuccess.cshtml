@model BaiTapLon.Models.Order
@{
    ViewData["Title"] = "Đặt Món Thành Công - Đơn #" + Model.OrderId;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 text-center p-4 p-md-5 bg-white position-relative overflow-hidden">
                <!-- Top gradient stripe -->
                <div style="position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, #10b981, #f59e0b);"></div>

                <div class="my-3">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success mb-2" style="width: 84px; height: 84px;">
                        <i class="fas fa-check fa-3x"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-dark mb-1">Đặt Món Thành Công!</h3>
                <p class="text-muted small mb-4">Cảm ơn bạn đã lựa chọn trải nghiệm tại Coffee Paradise.</p>

                <!-- Digital Receipt Box -->
                <div class="p-4 rounded-4 text-start mb-4 border" style="background: var(--coffee-cream); border-style: dashed !important; border-color: var(--coffee-cream-dark) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="fw-bold text-uppercase small text-muted">Hóa Đơn Điện Tử</span>
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">#@Model.OrderId</span>
                    </div>

                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Khách hàng:</span>
                        <span class="fw-bold text-dark">@Model.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="text-dark">@Model.CustomerPhone</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Hình thức / Bàn:</span>
                        <span class="fw-bold text-primary">@(Model.Table != null ? $"{Model.Table.TableName} ({Model.Table.Area})" : "Mang về (Take-away)")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Thời gian đặt:</span>
                        <span class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge bg-warning text-dark">@Model.Status (Quầy đang xử lý)</span>
                    </div>

                    <hr class="my-3 border-secondary border-opacity-25" />

                    <!-- Danh sách món đã đặt -->
                    <h6 class="fw-bold mb-2 text-muted small text-uppercase">Danh sách món:</h6>
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var d in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between align-items-center small">
                                <div>
                                    <span class="fw-bold text-dark">@d.Quantity x</span> @(d.Product?.Name ?? $"Món #{d.ProductId}")
                                </div>
                                <span class="fw-semibold text-muted">@((d.UnitPrice * d.Quantity).ToString("N0")) đ</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold fs-6 text-dark">Tổng tiền:</span>
                        <span class="fw-bold fs-5" style="color: var(--coffee-primary);">@Model.TotalAmount.ToString("N0") VNĐ</span>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn-coffee-outline">
                        <i class="fas fa-home me-1"></i> Về Trang Chủ
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn-coffee-amber">
                        <i class="fas fa-book-open me-1"></i> Đặt Thêm Món
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
