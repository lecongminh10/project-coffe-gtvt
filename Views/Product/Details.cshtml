@model BaiTapLon.Models.Product
@{
    ViewData["Title"] = Model.Name + " - Chi Tiết Thức Uống";
    var related = ViewBag.RelatedProducts as List<BaiTapLon.Models.Product> ?? new List<BaiTapLon.Models.Product>();
    var approvedReviews = Model.Reviews.Where(r => r.IsApproved).OrderByDescending(r => r.CreatedAt).ToList();
    var averageRating = approvedReviews.Any() ? approvedReviews.Average(r => r.Rating) : 0;
}

<div class="container my-4 my-md-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white px-3 py-2 rounded-pill shadow-sm border d-inline-flex mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted"><i class="fas fa-home me-1"></i> Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-muted">Thực đơn</a></li>
            <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Main Detail Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
        <div class="row g-0">
            <div class="col-lg-5">
                <div class="h-100 d-flex align-items-center justify-content-center p-4" style="background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%); min-height: 380px;">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-4 shadow-md transition" style="max-height: 350px; object-fit: cover;" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                </div>
            </div>
            <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge px-3 py-1 rounded-pill fw-bold text-uppercase" style="font-size: 0.75rem; background: rgba(255, 91, 38, 0.12); color: var(--brand-primary);">
                        <i class="fas fa-tag me-1"></i> @(Model.Category?.Name ?? "Đồ uống")
                    </span>
                    @if (Model.IsFeatured)
                    {
                        <span class="badge px-3 py-1 rounded-pill fw-bold text-white" style="font-size: 0.75rem; background: linear-gradient(135deg, #FF5B26, #F43F5E);">
                            <i class="fas fa-fire me-1"></i> Best Seller 🔥
                        </span>
                    }
                </div>

                <h1 class="display-6 fw-bold text-dark mb-2">@Model.Name</h1>

                <div class="d-flex align-items-baseline gap-3 mb-3">
                    <span class="display-6 fw-bold" style="color: var(--brand-primary);">
                        @Model.Price.ToString("N0") <small class="fs-5 text-muted">VNĐ</small>
                    </span>
                    <div class="text-warning small"><i class="fas fa-star"></i><span class="text-muted ms-1">(@averageRating.ToString("N1")/5 · @approvedReviews.Count đánh giá)</span></div>
                </div>

                <p class="text-muted mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Thức uống được pha chế với nguồn nguyên liệu tươi ngon nhất, giữ trọn hương vị nguyên bản và năng lượng sảng khoái cho ngày mới." : Model.Description)
                </p>

                <!-- Quantity and Add to cart -->
                <div class="p-3 bg-light rounded-4 mb-4">
                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label class="form-label fw-bold small mb-1 text-muted d-block">Số lượng:</label>
                            <div class="qty-stepper">
                                <button type="button" class="qty-btn" onclick="adjustDetailQty(-1)">-</button>
                                <span class="qty-display" id="detailQtyDisplay">1</span>
                                <input type="hidden" id="detailQty" value="1" />
                                <button type="button" class="qty-btn" onclick="adjustDetailQty(1)">+</button>
                            </div>
                        </div>
                        <div class="col-auto flex-grow-1 align-self-end">
                            <button type="button" class="btn-coffee-amber w-100 py-3" onclick="addFromDetails(@Model.ProductId, '@Model.Name')">
                                <i class="fas fa-cart-plus me-1"></i> Thêm Vào Giỏ Hàng
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Service badges -->
                <div class="pt-3 border-top text-muted small">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle text-success fs-6"></i>
                                <span>100% Cà phê sạch nguyên chất</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-clock text-primary fs-6"></i>
                                <span>Phục vụ tại bàn & Giao hàng nhanh</span>
                            </div>
                        </div>
                    </div>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button class="btn btn-outline-danger rounded-pill"><i class="fas fa-heart me-1"></i> Thêm/bỏ yêu thích</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-7"><div class="card border-0 shadow-sm p-4 h-100"><h4 class="fw-bold mb-3">Đánh giá khách hàng</h4>
        @if (!approvedReviews.Any()) { <p class="text-muted">Chưa có đánh giá được duyệt.</p> }
        @foreach (var review in approvedReviews) { <div class="border-bottom py-3"><div class="d-flex justify-content-between"><strong>@review.CustomerName</strong><span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span></div><p class="mb-1">@review.Comment</p><small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div> }
        </div></div>
        <div class="col-lg-5"><div class="card border-0 shadow-sm p-4"><h4 class="fw-bold mb-3">Viết đánh giá</h4>
        @if (TempData["ReviewSuccess"] != null) { <div class="alert alert-success">@TempData["ReviewSuccess"]</div> }
        @if (TempData["ReviewError"] != null) { <div class="alert alert-danger">@TempData["ReviewError"]</div> }
        <form asp-controller="Review" asp-action="Create" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.ProductId"/><label class="form-label">Tên của bạn</label><input name="customerName" class="form-control mb-3" value="@(User.FindFirst("FullName")?.Value)" required/><label class="form-label">Số sao</label><select name="rating" class="form-select mb-3"><option value="5">5 - Tuyệt vời</option><option value="4">4 - Tốt</option><option value="3">3 - Bình thường</option><option value="2">2 - Chưa tốt</option><option value="1">1 - Không hài lòng</option></select><label class="form-label">Nhận xét</label><textarea name="comment" class="form-control mb-3" rows="4" maxlength="1000"></textarea><button class="btn btn-primary">Gửi đánh giá</button></form>
        </div></div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mb-4">
            <h4 class="fw-bold mb-3 text-dark">
                <i class="fas fa-thumbs-up text-warning me-2"></i> Món Cùng Danh Mục
            </h4>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4">
                @foreach (var r in related)
                {
                    <div class="col">
                        <div class="product-card-modern">
                            <div class="product-thumb-box" style="padding-top: 70%;">
                                <img src="@r.ImageUrl" alt="@r.Name" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                            </div>
                            <div class="product-card-body">
                                <h6 class="product-card-title">
                                    <a asp-action="Details" asp-route-id="@r.ProductId">@r.Name</a>
                                </h6>
                                <div class="product-card-footer">
                                    <span class="product-price-val">@r.Price.ToString("N0") <small>đ</small></span>
                                    <a asp-action="Details" asp-route-id="@r.ProductId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        Xem
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function adjustDetailQty(delta) {
            const input = document.getElementById('detailQty');
            const display = document.getElementById('detailQtyDisplay');
            let val = parseInt(input.value) + delta;
            if (val < 1) val = 1;
            if (val > 50) val = 50;
            input.value = val;
            display.innerText = val;
        }

        function addFromDetails(productId, productName) {
            const qty = parseInt(document.getElementById('detailQty').value) || 1;
            addToCartGlobal(productId, qty, productName);
        }
    </script>
}
