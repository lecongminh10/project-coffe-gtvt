@model BaiTapLon.Models.ViewModels.ProductFilterViewModel
@{
    ViewData["Title"] = "Thực Đơn Quán Café";
}

<div class="container my-4">
    <!-- Header Banner -->
    <div class="hero-coffee-banner p-4 p-md-5 mb-4 rounded-4" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.9)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80') center/cover;">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge px-3 py-1 rounded-pill fw-bold mb-2 text-white" style="background: var(--brand-primary);">✨ Khám Phá Menu</span>
                <h1 class="fw-bold mb-2 text-white">Thực Đơn Đồ Uống & Tráng Miệng</h1>
                <p class="mb-0 text-white-50">Thưởng thức hương vị nguyên bản từ hạt cà phê tuyển chọn & các món trà trái cây tươi mát, đá xay thơm ngon mỗi ngày.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Cart" asp-action="Index" class="btn-coffee-amber">
                    <i class="fas fa-shopping-bag"></i> Giỏ Hàng Của Bạn
                </a>
            </div>
        </div>
    </div>

    <!-- Category Filter ViewComponent (Hỗ trợ cuộn ngang trên điện thoại) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="d-flex align-items-center justify-content-between mb-2 px-1">
            <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">
                <i class="fas fa-filter text-warning me-1"></i> Lọc Theo Danh Mục:
            </span>
            <span class="text-muted small d-md-none"><i class="fas fa-arrows-alt-h me-1"></i> Vuốt ngang để xem thêm</span>
        </div>
        @await Component.InvokeAsync("CategoryMenu", new { selectedCategoryId = Model.SelectedCategoryId })
    </div>

    <!-- Toolbar: Search & Sort Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="row g-3 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted rounded-start-pill ps-3">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" id="searchKeyword" class="form-control border-start-0 border-end-0" 
                           placeholder="Tìm tên món: Cà phê muối, Trà đào, Latte..." 
                           value="@Model.SearchKeyword" 
                           onkeyup="if(event.key === 'Enter') executeSearch()" />
                    <button class="btn btn-coffee-primary rounded-end-pill px-4" type="button" onclick="executeSearch()">
                        Tìm Kiếm
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchKeyword) || Model.SelectedCategoryId != null)
                    {
                        <button class="btn btn-outline-secondary rounded-pill ms-2" type="button" onclick="resetFilter()" title="Xóa bộ lọc">
                            <i class="fas fa-times me-1"></i> Xóa lọc
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-5 text-md-end">
                <div class="d-flex align-items-center justify-content-md-end gap-2">
                    <label class="form-label mb-0 text-muted small text-nowrap"><i class="fas fa-sort-amount-down text-warning"></i> Sắp xếp:</label>
                    <select id="sortSelect" class="form-select form-select-sm rounded-pill w-auto" onchange="changeSort(this.value)">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Mặc định (Bán chạy)</option>
                        <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá: Thấp đến Cao</option>
                        <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá: Cao đến Thấp</option>
                        <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên món: A - Z</option>
                    </select>
                </div>
            </div>
        </div>
        <!-- Quick search tags -->
        <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top flex-wrap">
            <span class="text-muted small fw-bold"><i class="fas fa-bolt text-warning me-1"></i> Gợi ý nhanh:</span>
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1 small" onclick="document.getElementById('searchKeyword').value='Cà phê'; executeSearch();">☕ Cà phê</button>
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1 small" onclick="document.getElementById('searchKeyword').value='Trà'; executeSearch();">🍵 Trà hoa quả</button>
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1 small" onclick="document.getElementById('searchKeyword').value='Latte'; executeSearch();">🥛 Latte</button>
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1 small" onclick="document.getElementById('searchKeyword').value='Bánh'; executeSearch();">🥐 Bánh ngọt</button>
        </div>
    </div>

    <!-- Product Grid Container (Nạp AJAX không tải lại trang) -->
    <div id="productListContainer">
        @await Html.PartialAsync("_ProductListPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        let currentCategoryId = @(Model.SelectedCategoryId.HasValue ? Model.SelectedCategoryId.Value.ToString() : "null");
        let currentSearch = '@(Model.SearchKeyword ?? "")';
        let currentSort = '@(Model.SortOrder ?? "")';
        let currentPage = @Model.PageIndex;

        // Lọc theo danh mục qua AJAX
        function filterByCategory(catId, element) {
            currentCategoryId = catId;
            currentPage = 1;

            document.querySelectorAll('#categoryFilterContainer .category-pill-modern').forEach(el => el.classList.remove('active'));
            if (element) {
                element.classList.add('active');
            }

            loadProductsAjax();
        }

        // Tìm kiếm AJAX
        function executeSearch() {
            currentSearch = document.getElementById('searchKeyword').value;
            currentPage = 1;
            loadProductsAjax();
        }

        // Đổi sắp xếp
        function changeSort(sortVal) {
            currentSort = sortVal;
            currentPage = 1;
            loadProductsAjax();
        }

        // Đổi trang
        function changePage(page) {
            currentPage = page;
            loadProductsAjax();
            $('html, body').animate({ scrollTop: $('#productListContainer').offset().top - 100 }, 300);
        }

        // Reset bộ lọc
        function resetFilter() {
            currentCategoryId = null;
            currentSearch = '';
            currentSort = '';
            currentPage = 1;
            document.getElementById('searchKeyword').value = '';
            document.querySelectorAll('#categoryFilterContainer .category-pill-modern').forEach(el => el.classList.remove('active'));
            const allPill = document.querySelector('#categoryFilterContainer a[data-category-id=""]');
            if (allPill) allPill.classList.add('active');
            loadProductsAjax();
        }

        // Tải danh sách món AJAX
        function loadProductsAjax() {
            $('#productListContainer').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-3 text-muted fw-semibold">Đang cập nhật danh sách món...</p>
                </div>
            `);

            $.ajax({
                url: '/Product/GetProductsPartial',
                type: 'GET',
                data: {
                    categoryId: currentCategoryId,
                    search: currentSearch,
                    sort: currentSort,
                    page: currentPage
                },
                success: function (result) {
                    $('#productListContainer').html(result);
                },
                error: function () {
                    $('#productListContainer').html('<div class="alert alert-danger text-center rounded-4">Có lỗi xảy ra khi tải danh sách món. Vui lòng thử lại sau.</div>');
                }
            });
        }
    </script>
}
