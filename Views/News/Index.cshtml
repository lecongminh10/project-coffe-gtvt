@model List<BaiTapLon.Models.News>
@{ ViewData["Title"] = "Tin tức"; }
<div class="container py-5"><div class="text-center mb-5"><h1 class="fw-bold">Tin tức Brew & Go</h1><p class="text-muted">Câu chuyện cà phê, ưu đãi và sự kiện mới nhất.</p></div><div class="row g-4">@foreach(var n in Model){<div class="col-md-6 col-lg-4"><article class="card border-0 shadow-sm h-100"><img src="@(n.ImageUrl ?? "/images/products/ca-phe-den.jpg")" class="card-img-top" style="height:220px;object-fit:cover"/><div class="card-body d-flex flex-column"><small class="text-muted">@n.PublishedAt.ToString("dd/MM/yyyy") · @n.ViewCount lượt xem</small><h5 class="fw-bold mt-2">@n.Title</h5><p class="text-muted">@n.Summary</p><a asp-action="Details" asp-route-slug="@n.Slug" class="btn btn-outline-primary mt-auto">Đọc tiếp</a></div></article></div>}</div></div>
