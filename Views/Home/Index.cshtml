@{
    ViewData["Title"] = "Brew & Go Coffee - Khơi Nguồn Năng Lượng Mới";
    var categories = ViewBag.Categories as List<BaiTapLon.Models.Category> ?? new List<BaiTapLon.Models.Category>();
    var featuredProducts = ViewBag.FeaturedProducts as List<BaiTapLon.Models.Product> ?? new List<BaiTapLon.Models.Product>();
}

<div class="container my-4">
    <!-- Hero Banner (Exact match to Mockup Design) -->
    <div class="hero-banner-exact mb-5">
        <div class="row align-items-center">
            <!-- Left Info Column -->
            <div class="col-lg-7 pb-4 pb-lg-0">
                <div class="hero-leaf-pill">
                    <i class="fas fa-leaf text-warning"></i> Cà Phê Mộc 100% & Phục Vụ Thông Minh
                </div>
                
                <h1 class="hero-display-title">
                    Brew & Go Coffee,<br />
                    <span class="hero-orange-text">Khơi Nguồn Năng Lượng Mới</span>
                </h1>
                
                <p class="hero-sub-description">
                    Trải nghiệm từng ngụm cà phê thơm nồng được tuyển chọn kỹ lưỡng<br class="d-none d-md-inline" />
                    từ Cầu Đất & Buôn Ma Thuột. Đặt món tiện lợi tại bàn hoặc mang về siêu tốc.
                </p>
                
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Product" asp-action="Index" class="btn-hero-orange">
                        <i class="fas fa-book-open me-2"></i> Xem Thực Đơn Ngay <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="btn-hero-translucent">
                        <i class="fas fa-shopping-bag me-2"></i> Giỏ Hàng Của Bạn
                    </a>
                </div>
                
                <!-- 3 Feature Points -->
                <div class="d-flex align-items-center gap-4 flex-wrap mt-3 pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="feat-circle-icon" style="background: rgba(16, 185, 129, 0.22); color: #10B981;">
                            <i class="fas fa-leaf"></i>
                        </div>
                        <div class="small" style="line-height: 1.25;">
                            <span class="text-white-50 d-block" style="font-size: 0.75rem;">Nguyên liệu</span>
                            <strong class="text-white" style="font-size: 0.85rem;">thượng hạng</strong>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="feat-circle-icon" style="background: rgba(255, 164, 27, 0.22); color: #FFA41B;">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <div class="small" style="line-height: 1.25;">
                            <span class="text-white-50 d-block" style="font-size: 0.75rem;">Pha chế</span>
                            <strong class="text-white" style="font-size: 0.85rem;">siêu tốc</strong>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="feat-circle-icon" style="background: rgba(244, 63, 94, 0.22); color: #F43F5E;">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="small" style="line-height: 1.25;">
                            <span class="text-white-50 d-block" style="font-size: 0.75rem;">Hương vị</span>
                            <strong class="text-white" style="font-size: 0.85rem;">đậm đà</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Glass Card Column -->
            <div class="col-lg-5 col-xl-4 ms-auto d-none d-lg-block">
                <div class="hero-glass-card-exact">
                    <div class="glass-status-tag mb-3">
                        <span class="green-indicator-dot"></span> Đang Mở Cửa Phục Vụ
                    </div>
                    <div class="my-2">
                        <i class="fas fa-mug-hot fa-3x" style="color: #FF5A1F;"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-1">07:00 AM - 22:30 PM</h4>
                    <p class="text-white-50 small mb-3">Thứ Hai - Chủ Nhật hàng tuần</p>
                    <hr class="border-white border-opacity-15 my-3" />
                    <div class="text-start text-white-50 small d-flex flex-column gap-2 ps-2">
                        <div><i class="fas fa-wifi text-warning me-2"></i> Wifi 6 siêu tốc độ cao</div>
                        <div><i class="fas fa-plug text-warning me-2"></i> Ổ sạc điện tại mọi bàn ngồi</div>
                        <div><i class="fas fa-motorcycle text-warning me-2"></i> Nhận đơn giao hàng tận nơi</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Carousel Dots Indicator (Centered) -->
        <div class="carousel-dots-bottom">
            <span class="dot-item active"></span>
            <span class="dot-item"></span>
            <span class="dot-item"></span>
        </div>

        <!-- Script Handwriting in bottom right corner -->
        <div class="good-coffee-script d-none d-md-block">
            Good Coffee<br />Better Days
        </div>
    </div>

    <!-- Section Heading: THỰC ĐƠN ĐA DẠNG -->
    <div class="text-center my-5">
        <div class="section-tag-orange-wrap">
            <span class="section-tag-dash"></span>
            <span class="section-tag-orange-text">THỰC ĐƠN ĐA DẠNG</span>
        </div>
        <h2 class="section-heading-bold">Lựa Chọn Thức Uống Yêu Thích</h2>
        <p class="section-subtext">Khám phá các bộ sưu tập thức uống phong phú từ cà phê, trà hoa quả đến bánh ngọt</p>
    </div>

    <!-- 5 Horizontal Bento Cards (Matching the Mockup) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 mb-5">
        <!-- 1. Cà Phê -->
        <div class="col">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="bento-category-card">
                <div class="bento-cat-icon">
                    <i class="fas fa-coffee"></i>
                </div>
                <div class="bento-cat-info">
                    <h6>Cà Phê</h6>
                    <span>Đậm đà, nguyên chất</span>
                </div>
            </a>
        </div>

        <!-- 2. Trà Sữa -->
        <div class="col">
            <a asp-controller="Product" asp-action="Index" class="bento-category-card">
                <div class="bento-cat-icon">
                    <i class="fas fa-glass-martini-alt"></i>
                </div>
                <div class="bento-cat-info">
                    <h6>Trà Sữa</h6>
                    <span>Ngọt ngào, hấp dẫn</span>
                </div>
            </a>
        </div>

        <!-- 3. Trà Hoa Quả -->
        <div class="col">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="bento-category-card">
                <div class="bento-cat-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <div class="bento-cat-info">
                    <h6>Trà Hoa Quả</h6>
                    <span>Thanh mát, tự nhiên</span>
                </div>
            </a>
        </div>

        <!-- 4. Bánh Ngọt -->
        <div class="col">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="bento-category-card">
                <div class="bento-cat-icon">
                    <i class="fas fa-cookie-bite"></i>
                </div>
                <div class="bento-cat-info">
                    <h6>Bánh Ngọt</h6>
                    <span>Tươi ngon mỗi ngày</span>
                </div>
            </a>
        </div>

        <!-- 5. Đồ Uống Đá Xay -->
        <div class="col">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="bento-category-card">
                <div class="bento-cat-icon">
                    <i class="fas fa-snowflake"></i>
                </div>
                <div class="bento-cat-info">
                    <h6>Đồ Uống Đá Xay</h6>
                    <span>Mát lạnh, sảng khoái</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Món Bán Chạy / Featured Products -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <span class="badge px-3 py-1 rounded-pill fw-bold text-uppercase small mb-1" style="background: rgba(244, 63, 94, 0.12); color: #F43F5E;">
                🔥 Được Yêu Thích Nhất
            </span>
            <h2 class="fw-bold text-dark mb-0">
                Món Hot Trend Bán Chạy Hàng Đầu
            </h2>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn-coffee-outline">
            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4 mb-5">
        @foreach (var item in featuredProducts)
        {
            <div class="col">
                <div class="product-card-modern">
                    <div class="product-thumb-box">
                        <span class="product-badge-float">
                            <i class="fas fa-fire-alt"></i> Bán chạy
                        </span>
                        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                        <span class="product-category-chip">
                            @(item.Category?.Name ?? "Đồ uống")
                        </span>
                    </div>
                    <div class="product-card-body">
                        <h5 class="product-card-title">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                @item.Name
                            </a>
                        </h5>
                        <p class="product-card-desc">
                            @(string.IsNullOrEmpty(item.Description) ? "Thức uống thơm ngon được pha chế tươi mới mỗi ngày." : item.Description)
                        </p>
                        <div class="product-card-footer">
                            <span class="product-price-val">
                                @item.Price.ToString("N0") <small>đ</small>
                            </span>
                            <button type="button" class="btn-add-cart-mini" onclick="addToCartGlobal(@item.ProductId, 1, '@item.Name')">
                                <i class="fas fa-plus"></i> Chọn
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Điểm Nổi Bật / Lý Do Chọn Brew & Go -->
    <div class="row g-3 g-md-4 py-4 text-center">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition" style="border-color: rgba(226, 232, 240, 0.8) !important;">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 text-white shadow-sm" style="width: 68px; height: 68px; background: linear-gradient(135deg, #10B981, #059669);">
                    <i class="fas fa-seedling fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Hạt Cà Phê Mộc 100%</h5>
                <p class="text-muted small mb-0">Tuyển chọn nghiêm ngặt từ Cầu Đất & Buôn Ma Thuột, rang mộc giữ trọn vẹn hương quả chín tự nhiên.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition" style="border-color: rgba(226, 232, 240, 0.8) !important;">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 text-white shadow-sm" style="width: 68px; height: 68px; background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));">
                    <i class="fas fa-bolt fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Phục Vụ Siêu Tốc</h5>
                <p class="text-muted small mb-0">Hệ thống đặt món thông minh, quản lý bàn và đồ uống theo thời gian thực giúp giảm thiểu tối đa thời gian chờ đợi.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition" style="border-color: rgba(226, 232, 240, 0.8) !important;">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 text-white shadow-sm" style="width: 68px; height: 68px; background: linear-gradient(135deg, #8B5CF6, #6D28D9);">
                    <i class="fas fa-heart fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Không Gian Lý Tưởng</h5>
                <p class="text-muted small mb-0">Không gian thiết kế tươi trẻ, bàn rộng có ổ cắm điện và điều hòa mát mẻ, điểm đến hoàn hảo để học tập và chill.</p>
            </div>
        </div>
    </div>
</div>
