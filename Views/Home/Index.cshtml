@{
    ViewData["Title"] = "Thương Hiệu Cà Phê Nguyên Bản & Không Gian Thư Thái";
    var categories = ViewBag.Categories as List<BaiTapLon.Models.Category> ?? new List<BaiTapLon.Models.Category>();
    var featuredProducts = ViewBag.FeaturedProducts as List<BaiTapLon.Models.Product> ?? new List<BaiTapLon.Models.Product>();
}

<div class="container my-4">
    <!-- Hero Banner -->
    <div class="hero-coffee-banner mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-pill-badge">
                    <i class="fas fa-certificate text-warning"></i> Cà Phê Tây Nguyên Rang Mộc 100%
                </div>
                <h1 class="hero-title-gradient">
                    Hương Vị Đậm Đà,<br />
                    <span>Khơi Nguồn Cảm Hứng</span>
                </h1>
                <p class="lead text-white-50 mb-4 pe-lg-4" style="font-size: 1.1rem;">
                    Khám phá từng giọt cà phê thơm nồng được tuyển chọn kỹ lưỡng, hòa quyện nghệ thuật pha chế tinh tế trong không gian hiện đại, yên tĩnh để học tập và kết nối.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn-coffee-amber">
                        <i class="fas fa-book-open"></i> Xem Thực Đơn Ngay
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="fas fa-shopping-bag"></i> Giỏ Hàng Của Bạn
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block">
                <div class="hero-glass-card">
                    <div class="d-inline-flex align-items-center gap-2 mb-3 bg-white bg-opacity-10 px-3 py-1 rounded-pill">
                        <span class="status-pulse-dot"></span>
                        <span class="text-white small fw-bold">Đang Mở Cửa Phục Vụ</span>
                    </div>
                    <div class="my-2">
                        <i class="fas fa-mug-hot fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-1">07:00 AM - 22:30 PM</h5>
                    <p class="text-white-50 small mb-3">Thứ Hai - Chủ Nhật hàng tuần</p>
                    <hr class="border-white border-opacity-15 my-3" />
                    <div class="text-start text-white-50 small d-flex flex-column gap-2">
                        <div><i class="fas fa-wifi text-warning me-2"></i> Wifi 6 siêu tốc độ cao</div>
                        <div><i class="fas fa-plug text-warning me-2"></i> Ổ sạc điện tại mọi bàn ngồi</div>
                        <div><i class="fas fa-motorcycle text-warning me-2"></i> Nhận đơn giao hàng tận nơi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh Mục Thức Uống Nổi Bật -->
    <div class="text-center mb-4">
        <span class="badge bg-warning bg-opacity-15 text-warning px-3 py-1 rounded-pill fw-bold text-uppercase small mb-2">Menu Khởi Đầu</span>
        <h2 class="fw-bold text-dark">Lựa Chọn Thức Uống Yêu Thích</h2>
        <p class="text-muted small">Khám phá các bộ sưu tập thức uống phong phú từ cà phê, trà hoa quả đến bánh ngọt</p>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 mb-5">
        @foreach (var cat in categories)
        {
            <div class="col">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="cat-item-card text-decoration-none">
                    <div class="cat-icon-circle">
                        <i class="fas @(string.IsNullOrEmpty(cat.Icon) ? "fa-mug-hot" : cat.Icon)"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">@cat.Name</h6>
                    <small class="text-muted">@(cat.Products?.Count ?? 0) món</small>
                </a>
            </div>
        }
    </div>

    <!-- Món Bán Chạy / Featured Products -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill fw-bold text-uppercase small mb-1">Được Yêu Thích Nhất</span>
            <h2 class="fw-bold text-dark mb-0">
                <i class="fas fa-fire text-danger me-2"></i> Món Bán Chạy Hàng Đầu
            </h2>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn-coffee-outline">
            Xem tất cả <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4 mb-5">
        @foreach (var item in featuredProducts)
        {
            <div class="col">
                <div class="product-card-modern">
                    <div class="product-thumb-box">
                        <span class="product-badge-float">
                            <i class="fas fa-star"></i> Bán chạy
                        </span>
                        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" onerror="this.src='/images/products/ca-phe-den.jpg'" />
                        <span class="product-category-chip">
                            @(item.Category?.Name ?? "Đồ uống")
                        </span>
                    </div>
                    <div class="product-card-body">
                        <h5 class="product-card-title">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                @item.Name
                            </a>
                        </h5>
                        <p class="product-card-desc">
                            @(string.IsNullOrEmpty(item.Description) ? "Thức uống thơm ngon được pha chế tươi mới." : item.Description)
                        </p>
                        <div class="product-card-footer">
                            <span class="product-price-val">
                                @item.Price.ToString("N0") <small>đ</small>
                            </span>
                            <button type="button" class="btn-add-cart-mini" onclick="addToCartGlobal(@item.ProductId, 1, '@item.Name')">
                                <i class="fas fa-cart-plus"></i> Chọn
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Điểm Nổi Bật / Cam Kết Chất Lượng -->
    <div class="row g-3 g-md-4 py-4 text-center">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 bg-success bg-opacity-10 text-success" style="width: 65px; height: 65px;">
                    <i class="fas fa-seedling fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Hạt Cà Phê Mộc 100%</h5>
                <p class="text-muted small mb-0">Tuyển chọn nghiêm ngặt từ Cầu Đất & Buôn Ma Thuột, rang mộc giữ trọn vẹn hương quả chín tự nhiên.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 bg-warning bg-opacity-10 text-warning" style="width: 65px; height: 65px;">
                    <i class="fas fa-bolt fa-2x text-warning"></i>
                </div>
                <h5 class="fw-bold text-dark">Phục Vụ Siêu Tốc</h5>
                <p class="text-muted small mb-0">Hệ thống đặt món thông minh, quản lý bàn và đồ uống theo thời gian thực giúp giảm thiểu tối đa thời gian chờ đợi.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100 transition">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 bg-danger bg-opacity-10 text-danger" style="width: 65px; height: 65px;">
                    <i class="fas fa-heart fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Không Gian Lý Tưởng</h5>
                <p class="text-muted small mb-0">Không gian thiết kế ấm cúng, bàn rộng có ổ cắm điện và điều hòa mát mẻ, điểm đến hoàn hảo để làm việc và chill.</p>
            </div>
        </div>
    </div>
</div>
