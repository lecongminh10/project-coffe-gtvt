<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brew & Go Coffee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Clean Crisp Header matching exact design -->
    <header class="coffee-navbar-wrapper bg-white shadow-xs">
        <nav class="navbar navbar-expand-lg coffee-navbar py-2">
            <div class="container">
                <a class="navbar-brand-modern" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box" style="background: #FF5A1F; border-radius: 12px; width: 40px; height: 40px; box-shadow: 0 4px 12px rgba(255, 90, 31, 0.3);">
                        <i class="fas fa-mug-hot text-white"></i>
                    </div>
                    <div>
                        <span class="fw-bold text-dark fs-4" style="letter-spacing: -0.5px;">Brew & Go</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars fa-lg text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-5 gap-3">
                        <li class="nav-item">
                            <a class="nav-link-item active-nav-orange" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Khám Phá
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-item text-dark" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="fas fa-list me-1"></i> Thực Đơn (Menu)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-item text-dark" asp-area="" asp-controller="News" asp-action="Index">
                                <i class="fas fa-newspaper me-1"></i> Tin Tức
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center gap-3">
                        <!-- Search Circle Button -->
                        <li class="nav-item">
                            <a asp-controller="Product" asp-action="Index" class="btn-circle-search" title="Tìm kiếm món">
                                <i class="fas fa-search"></i>
                            </a>
                        </li>

                        <!-- Cart Widget Component -->
                        <li class="nav-item">
                            @await Component.InvokeAsync("CartWidget")
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-0 text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 36px; height: 36px; font-size: 0.9rem; background: #F59E0B;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")
                                    </div>
                                    <span>@User.Identity.Name</span>
                                    <i class="fas fa-chevron-down small text-muted"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item py-2 rounded-3" asp-area="" asp-controller="Wishlist" asp-action="Index"><i class="fas fa-heart me-2 text-danger"></i> Món Yêu Thích</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                    {
                                        <li>
                                            <a class="dropdown-item fw-bold text-danger py-2 rounded-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="fas fa-tachometer-alt me-2 text-danger"></i> Trang Quản Trị
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2 rounded-3">
                                                <i class="fas fa-sign-out-alt me-2"></i> Đăng Xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn-nav-login" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-user me-1"></i> Đăng Nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-nav-register" asp-area="" asp-controller="Account" asp-action="Register">
                                    Đăng Ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Floating Action Button (Chat Bubble from design) -->
    <a href="https://zalo.me" target="_blank" class="floating-chat-bubble" title="Hỗ trợ & Đặt bàn">
        <i class="fas fa-comment-dots"></i>
    </a>

    <!-- Global Toast Notification Container -->
    <div id="globalCoffeeToastContainer" class="coffee-toast-container"></div>

    <!-- Modern Rich Footer -->
    <footer class="coffee-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-box" style="width: 38px; height: 38px; font-size: 1.1rem;">
                            <i class="fas fa-mug-hot"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-white">Brew & Go Coffee</h5>
                    </div>
                    <p class="text-white-50 small pe-lg-3">
                        Hệ thống cà phê nguyên bản và phục vụ thông minh. Nguồn hạt Arabica Cầu Đất & Robusta Buôn Ma Thuột hảo hạng, đặt món nhanh tại bàn hoặc mang về siêu tốc.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#!" class="footer-social-icon" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#!" class="footer-social-icon" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#!" class="footer-social-icon" title="TikTok"><i class="fab fa-tiktok"></i></a>
                        <a href="#!" class="footer-social-icon" title="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-uppercase small mb-3 text-warning" style="letter-spacing: 1px;">Khám Phá</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-link">Trang Chủ</a></li>
                        <li><a asp-controller="Product" asp-action="Index" class="footer-link">Thực Đơn (Menu)</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="footer-link">Giỏ Hàng</a></li>
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="footer-link">Trang Quản Trị</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase small mb-3 text-warning" style="letter-spacing: 1px;">Giờ Mở Cửa</h6>
                    <p class="text-white-50 small mb-2"><i class="fas fa-clock text-warning me-2"></i> Thứ 2 - Thứ 6: <strong>07:00 - 22:30</strong></p>
                    <p class="text-white-50 small mb-2"><i class="fas fa-clock text-warning me-2"></i> Thứ 7 - CN: <strong>06:30 - 23:00</strong></p>
                    <p class="text-white-50 small mb-0"><i class="fas fa-wifi text-warning me-2"></i> Ổ điện & Wifi 6 tốc độ cao miễn phí</p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase small mb-3 text-warning" style="letter-spacing: 1px;">Liên Hệ Đặt Chỗ</h6>
                    <p class="text-white-50 small mb-2"><i class="fas fa-map-marker-alt text-warning me-2"></i> Trường Đại học GTVT, Hà Nội</p>
                    <p class="text-white-50 small mb-2"><i class="fas fa-phone-alt text-warning me-2"></i> Hotline: <strong class="text-white">0901 234 567</strong></p>
                    <p class="text-white-50 small mb-0"><i class="fas fa-envelope text-warning me-2"></i> contact@brewandgo.vn</p>
                </div>
            </div>

            <div class="border-top border-white border-opacity-10 pt-3 mt-4 text-center small text-white-50">
                &copy; @DateTime.Now.Year <strong>Brew & Go Coffee</strong> - Hệ thống quản lý & đặt món thông minh.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
